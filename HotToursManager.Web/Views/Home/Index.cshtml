@model IEnumerable<HotToursManager.Models.Tour>

@{
    ViewData["Title"] = "Список туров";

    var toursList = Model?.ToList() ?? new List<HotToursManager.Models.Tour>();
    var totalTours = toursList.Count;
    var totalCost = toursList.Sum(t => t.TotalCost);
    var toursWithSurcharges = toursList.Count(t => t.Surcharges > 0);
    var totalSurcharges = toursList.Sum(t => t.Surcharges);
}

<!-- ==================== БЛОК СТАТИСТИКИ ==================== -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body text-center">
                <h5 class="card-title">📋 Всего туров</h5>
                <h2>@totalTours</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body text-center">
                <h5 class="card-title">💰 Общая стоимость</h5>
                <h2>@totalCost.ToString("N2") ₽</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body text-center">
                <h5 class="card-title">💳 Общая сумма доплат</h5>
                <h2>@totalSurcharges.ToString("N2") ₽</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body text-center">
                <h5 class="card-title">📌 Туров с доплатами</h5>
                <h2>@toursWithSurcharges</h2>
                <small>из @totalTours туров</small>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>📋 Список туров</h1>
    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createModal">
        ➕ Добавить новый тур
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <h4>Список туров пуст</h4>
        <p>Добавьте первый тур, нажав кнопку выше.</p>
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Направление</th>
                <th>Дата вылета</th>
                <th>Ночей</th>
                <th>Цена за чел.</th>
                <th>Кол-во людей</th>
                <th>Wi-Fi</th>
                <th>Доплаты</th>
                <th>Общая стоимость</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><strong>@item.Destination</strong></td>
                    <td>@item.DepartureDate.ToString("dd.MM.yyyy")</td>
                    <td>@item.Nights</td>
                    <td>@item.CostPerPerson.ToString("N2") ₽</td>
                    <td>@item.NumberOfPeople</td>
                    <td>@(item.HasWiFi ? "✅" : "❌")</td>
                    <td>@item.Surcharges.ToString("N2") ₽</td>
                    <td><strong>@item.TotalCost.ToString("N2") ₽</strong></td>
                    <td>
                        <!-- Кнопка редактирования с data-атрибутами -->
                        <button type="button" class="btn btn-sm btn-warning"
                                data-bs-toggle="modal"
                                data-bs-target="#editModal"
                                data-tour-id="@item.Id"
                                data-tour-destination="@item.Destination"
                                data-tour-departure="@item.DepartureDate.ToString("yyyy-MM-dd")"
                                data-tour-nights="@item.Nights"
                                data-tour-cost="@item.CostPerPerson"
                                data-tour-people="@item.NumberOfPeople"
                                data-tour-wifi="@item.HasWiFi.ToString().ToLower()"
                                data-tour-surcharges="@item.Surcharges">
                            ✏️
                        </button>
                        <!-- Кнопка удаления с data-атрибутами -->
                        <button type="button" class="btn btn-sm btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-tour-id="@item.Id"
                                data-tour-destination="@item.Destination">
                            🗑️
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- ==================== МОДАЛКА СОЗДАНИЯ ==================== -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">➕ Создать новый тур</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Направление <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Destination"
                               required minlength="2" maxlength="100"
                               title="Введите направление от 2 до 100 символов" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Дата вылета <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" name="DepartureDate"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required
                               title="Выберите дату вылета" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Количество ночей <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" name="Nights" min="1" max="99" required
                                   title="Введите количество ночей от 1 до 99" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Цена за человека (₽) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" name="CostPerPerson"
                                   step="0.01" min="1000" max="500000" required
                                   title="Введите цену от 1000 до 500 000" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Количество отдыхающих <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="NumberOfPeople"
                               min="1" max="5" required
                               title="Введите количество людей от 1 до 5" />
                    </div>
                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" id="CreateHasWiFi" name="HasWiFi" value="true" />
                        <label class="form-check-label" for="CreateHasWiFi">Наличие Wi-Fi</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Доплаты (₽)</label>
                        <input type="number" class="form-control" name="Surcharges"
                               step="0.01" min="0" max="100000" value="0"
                               title="Введите доплаты от 0 до 100 000" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-success">💾 Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ==================== МОДАЛКА РЕДАКТИРОВАНИЯ ==================== -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editForm" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editId" name="Id" />
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">✏️ Редактировать тур</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Направление <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editDestination" name="Destination"
                               required minlength="2" maxlength="100"
                               title="Введите направление от 2 до 100 символов" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Дата вылета <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="editDepartureDate" name="DepartureDate"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required
                               title="Выберите дату вылета" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Количество ночей <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="editNights" name="Nights"
                                   min="1" max="99" required
                                   title="Введите количество ночей от 1 до 99" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Цена за человека (₽) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="editCostPerPerson" name="CostPerPerson"
                                   step="0.01" min="1000" max="500000" required
                                   title="Введите цену от 1000 до 500 000" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Количество отдыхающих <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="editNumberOfPeople" name="NumberOfPeople"
                               min="1" max="5" required
                               title="Введите количество людей от 1 до 5" />
                    </div>
                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" id="editHasWiFi" name="HasWiFi" value="true" />
                        <label class="form-check-label" for="editHasWiFi">Наличие Wi-Fi</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Доплаты (₽)</label>
                        <input type="number" class="form-control" id="editSurcharges" name="Surcharges"
                               step="0.01" min="0" max="100000"
                               title="Введите доплаты от 0 до 100 000" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-warning">💾 Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ==================== МОДАЛКА УДАЛЕНИЯ ==================== -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteForm" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteTourId" name="id" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">🗑️ Подтверждение удаления</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Вы действительно хотите удалить тур <strong id="tourDestination"></strong>?</p>
                    <p class="text-danger">Это действие нельзя отменить.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-danger">🗑️ Да, удалить</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var editModal = document.getElementById('editModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            // Кнопка, которая открыла модалку
            var button = event.relatedTarget;

            // Извлекаем данные из data-атрибутов
            var id = button.getAttribute('data-tour-id');
            var destination = button.getAttribute('data-tour-destination');
            var departure = button.getAttribute('data-tour-departure');
            var nights = button.getAttribute('data-tour-nights');
            var cost = button.getAttribute('data-tour-cost');
            var people = button.getAttribute('data-tour-people');
            var wifi = button.getAttribute('data-tour-wifi');
            var surcharges = button.getAttribute('data-tour-surcharges');

            // Заполнение поля формы
            document.getElementById('editId').value = id;
            document.getElementById('editDestination').value = destination;
            document.getElementById('editDepartureDate').value = departure;
            document.getElementById('editNights').value = nights;
            document.getElementById('editCostPerPerson').value = cost;
            document.getElementById('editNumberOfPeople').value = people;
            document.getElementById('editHasWiFi').checked = wifi === 'true';
            document.getElementById('editSurcharges').value = surcharges;
        });

        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var tourId = button.getAttribute('data-tour-id');
            var tourDestination = button.getAttribute('data-tour-destination');

            document.getElementById('tourDestination').textContent = tourDestination;
            document.getElementById('deleteTourId').value = tourId;
        });
    </script>
}
